generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id            String    @id @default(dbgenerated("gen_random_uuid()"))
  email         String
  fullName      String?   @map("full_name")
  phone         String?
  role          String    @default("customer")
  avatarUrl     String?   @map("avatar_url")
  password      String?
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")

  accounts       Account[]
  sessions       Session[]
  orders         Order[]
  reviews        Review[]
  wishlists      Wishlist[]
  addresses      Address[]
  supportTickets SupportTicket[]

  @@map("profiles")
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()"))
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id          String        @id @default(dbgenerated("gen_random_uuid()"))
  name        String
  slug        String        @unique
  description String?
  imageUrl    String?       @map("image_url")
  sortOrder   Int           @default(0) @map("sort_order")
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")

  subCategories SubCategory[]
  products      Product[]

  @@map("categories")
}

model SubCategory {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  categoryId String   @map("category_id")
  name       String
  slug       String
  createdAt  DateTime @default(now()) @map("created_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([categoryId, slug])
  @@map("sub_categories")
}

model Brand {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  name      String   @unique
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("brands")
}

model Product {
  id              String        @id @default(dbgenerated("gen_random_uuid()"))
  name            String
  slug            String        @unique
  description     String?
  productType     String        @default("general") @map("product_type")

  categoryId      String?       @map("category_id")
  subCategoryId   String?       @map("sub_category_id")
  brandId         String?       @map("brand_id")

  purchasePrice   Decimal       @default(0) @map("purchase_price")
  salesPrice      Decimal       @default(0) @map("sales_price")
  discountPercent Decimal       @default(0) @map("discount_percent")
  quantityType    String?       @map("quantity_type")
  quantity        Decimal?
  stockType       String?       @map("stock_type")
  stock           Int           @default(0) @map("stock")

  foodType        String?       @map("food_type")
  gender          String?
  productCategory String?       @map("product_category")

  rating          Decimal       @default(0)
  reviewCount     Int           @default(0) @map("review_count")
  isFeatured      Boolean       @default(false) @map("is_featured")
  isBestSeller    Boolean       @default(false) @map("is_best_seller")
  isPopular       Boolean       @default(false) @map("is_popular")
  isTodayDeal     Boolean       @default(false) @map("is_today_deal")
  isActive        Boolean       @default(true) @map("is_active")
  metadata        Json          @default("{}")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @default(now()) @map("updated_at")

  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subCategory   SubCategory?    @relation(fields: [subCategoryId], references: [id], onDelete: SetNull)
  brand         Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  productImages ProductImage[]
  variants      ProductVariant[]
  reviews       Review[]
  wishlists     Wishlist[]
  orderItems    OrderItem[]
  pujaItems     PujaItem[]

  @@map("products")
}

model ProductImage {
  id        String @id @default(dbgenerated("gen_random_uuid()"))
  productId String @map("product_id")
  url       String
  alt       String?
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  productId String   @map("product_id")
  name      String
  sku       String?  @unique
  price     Decimal  @default(0)
  stock     Int      @default(0)
  sortOrder Int      @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model Essential {
  id          String   @id @default(dbgenerated("gen_random_uuid()"))
  name        String
  category    String
  stockType   String?  @map("stock_type")
  stock       Int      @default(0)
  price       Decimal  @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @map("updated_at")

  essentialImages EssentialImage[]

  @@map("essentials")
}

model EssentialImage {
  id          String @id @default(dbgenerated("gen_random_uuid()"))
  essentialId String @map("essential_id")
  url         String
  alt         String?
  sortOrder   Int    @default(0) @map("sort_order")

  essential Essential @relation(fields: [essentialId], references: [id], onDelete: Cascade)

  @@map("essential_images")
}

model Puja {
  id          String     @id @default(dbgenerated("gen_random_uuid()"))
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?    @map("image_url")
  basePrice   Decimal    @default(0) @map("base_price")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")

  items      PujaItem[]
  pandits    PujaPandit[]
  orderItems OrderItem[]

  @@map("pujas")
}

model PujaItem {
  id        String @id @default(dbgenerated("gen_random_uuid()"))
  pujaId    String @map("puja_id")
  productId String? @map("product_id")
  name      String
  unit      String @default("pc")
  price     Decimal @default(0)
  defaultQty Int   @default(1) @map("default_qty")
  sortOrder Int    @default(0) @map("sort_order")

  puja    Puja?    @relation(fields: [pujaId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@map("puja_items")
}

model Pandit {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  name       String
  experience Int      @default(0)
  languages  String[]
  rating     Decimal  @default(5)
  price      Decimal  @default(0)
  photoUrl   String?  @map("photo_url")
  bio        String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  pujas    PujaPandit[]
  orderItems OrderItem[]

  @@map("pandits")
}

model PujaPandit {
  pujaId   String @map("puja_id")
  panditId String @map("pandit_id")

  puja   Puja   @relation(fields: [pujaId], references: [id], onDelete: Cascade)
  pandit Pandit @relation(fields: [panditId], references: [id], onDelete: Cascade)

  @@id([pujaId, panditId])
  @@map("puja_pandits")
}

model Review {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  productId String   @map("product_id")
  userId    String   @map("user_id")
  rating    Int
  title     String?
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Coupon {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  code           String    @unique
  description    String?
  discountPercent Decimal  @default(0) @map("discount_percent")
  maxDiscount    Decimal   @default(0) @map("max_discount")
  minOrder       Decimal   @default(0) @map("min_order")
  isActive       Boolean   @default(true) @map("is_active")
  validUntil     DateTime? @map("valid_until")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("coupons")
}

model Address {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  userId    String   @map("user_id")
  fullName  String   @map("full_name")
  phone     String
  line1     String
  line2     String?
  city      String
  district  String?
  region    String?
  block     String?
  country   String? @default("India")
  state     String
  pincode   String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Order {
  id            String    @id @default(dbgenerated("gen_random_uuid()"))
  userId        String    @map("user_id")
  orderNumber   String    @unique @map("order_number")
  status        String    @default("pending")
  subtotal      Decimal   @default(0)
  discount      Decimal   @default(0)
  shipping      Decimal   @default(0)
  tax           Decimal   @default(0)
  total         Decimal   @default(0)
  couponCode    String?   @map("coupon_code")
  paymentMethod String    @default("cod") @map("payment_method")
  paymentStatus String    @default("pending") @map("payment_status")
  address       Json      @default("{}")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @map("updated_at")

  user  Profile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id         String   @id @default(dbgenerated("gen_random_uuid()"))
  orderId    String   @map("order_id")
  productId  String?  @map("product_id")
  pujaId     String?  @map("puja_id")
  panditId   String?  @map("pandit_id")
  name       String
  variantName String? @map("variant_name")
  imageUrl   String?  @map("image_url")
  unitPrice  Decimal  @default(0) @map("unit_price")
  quantity   Int      @default(1)
  total      Decimal  @default(0)
  itemType   String   @default("product") @map("item_type")
  metadata   Json     @default("{}")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  puja    Puja?    @relation(fields: [pujaId], references: [id], onDelete: SetNull)
  pandit  Pandit?  @relation(fields: [panditId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model Banner {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  title     String
  subtitle  String?
  imageUrl  String?  @map("image_url")
  ctaText   String?  @map("cta_text")
  ctaLink   String?  @map("cta_link")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("banners")
}

model Wishlist {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist")
}

model SupportTicket {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  userId    String   @map("user_id")
  subject   String
  message   String
  status    String   @default("open")
  createdAt DateTime @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}

model StoreConfig {
  id                   String   @id @default("store")
  foodOpenTime         String   @default("10:00") @map("food_open_time")
  foodCloseTime        String   @default("22:00") @map("food_close_time")
  foodIsOpen           Boolean  @default(true) @map("food_is_open")
  paymentMode          String   @default("both") @map("payment_mode")
  taxRate              Float    @default(5) @map("tax_rate")
  shippingCharge       Float    @default(49) @map("shipping_charge")
  freeShippingThreshold Float   @default(499) @map("free_shipping_threshold")
  updatedAt            DateTime @default(now()) @map("updated_at")

  @@map("store_config")
}
